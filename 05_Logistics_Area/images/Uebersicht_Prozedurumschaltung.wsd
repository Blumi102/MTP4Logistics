@startuml Uebersicht_Prozedurumschaltung
skinparam backgroundColor #FFFFFF

skinparam sequence {
ArrowColor #8A0808
LifeLineBorderColor #8A0808

ParticipantBorderColor #8A0808
ParticipantBackgroundColor #585858
ParticipantFontColor #FFFFFF
}

skinparam note {
borderColor #000000
backgroundColor #E6E6E6
}

participant "**LEA via**\n**Transport Node**" as LEA order 1
participant "**Transport Service**" as TOA order 2
participant "**AGV System via**\n**Transport Management**" as FMS order 3


activate LEA
activate FMS
activate TOA

LEA ->> TOA: PushRequested/PullRequested
FMS ->> TOA: Transport
FMS ->> TOA: TransportAwaitRequested
LEA ->> TOA: TransportAwaited
FMS ->> TOA: TransportArrived
LEA ->> TOA: TransferFromLea
LEA ->> TOA: TransferFromLeaSucceeded
FMS ->> TOA: Transport
FMS ->> TOA: TransportAwaitRequested
LEA ->> TOA: TransportAwaited
FMS ->> TOA: TransportArrived
LEA ->> TOA: Processing
LEA ->> TOA: ProcessingSucceeded
FMS ->> TOA: Transport
FMS ->> TOA: TransportAwaitRequested
LEA ->> TOA: TransportAwaited
FMS ->> TOA: TransportArrived
LEA ->> TOA: TransferToLea
LEA ->> TOA: TransferToLeaSucceeded


@enduml
