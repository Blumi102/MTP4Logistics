@startuml Empfohlene_Parametrierung_HMI
skinparam backgroundColor #FFFFFF

skinparam sequence {
ArrowColor #8A0808
LifeLineBorderColor #8A0808

ParticipantBorderColor #8A0808
ParticipantBackgroundColor #585858
ParticipantFontColor #FFFFFF
}

skinparam note {
borderColor #000000
backgroundColor #E6E6E6
}

participant "**LOL (Parameter**\n**Management)**" as PM order 3
participant "**LEA Service**" as Service order 4

activate PM
activate Service

Service <<- : HMI Input

hnote over Service
Modification of a parameter set in the ProductDataSet
end hnote

Service ->> PM: ProductParameterUpdatedInfo: Arrayindex = A

hnote over PM
Optional: Adopt the change into the database
end hnote

PM ->> Service: Change acknowledged

...

Service <<- : HMI Input

hnote over Service
Modification of a parameter set in the PackagingDataSet
end hnote

Service ->> PM: PackagingParameterUpdatedInfo: Arrayindex = B

hnote over PM
Optional: Adopt the change into the database
end hnote

PM ->> Service: Change acknowledged


@enduml
