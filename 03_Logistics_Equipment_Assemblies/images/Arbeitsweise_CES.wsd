@startuml Arbeitsweise_CES

skinparam backgroundColor #FFFFFF

skinparam sequence {
ArrowColor #8A0808
LifeLineBorderColor #8A0808

ParticipantBorderColor #8A0808
ParticipantBackgroundColor #585858
ParticipantFontColor #FFFFFF
}

participant "**Logistics**\n**Orchestration Layer**" as LOL order 1
participant "**Cyclic Execution**\n**Service**" as CES order 2

LOL <<- CES : state:IDLE
LOL ->> CES: Parameterization
LOL <<- CES : StartEn = true
LOL ->> CES: cmd:Start
LOL <<- CES: state:STARTING
LOL <<- CES: state:EXECUTE
activate CES
CES ->> CES: Cyclic \nProcessing\nof LOs
LOL ->> CES: cmd:Complete \n(if necessary)
deactivate CES
LOL <<- CES: state:COMPLETING
LOL <<- CES: state:COMPLETED
@enduml
